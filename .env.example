# Copy to .env and fill in. NEVER commit .env.

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j
# Inside docker compose the API reaches Neo4j by service name.
# For `make run` (API on your host) use bolt://localhost:7687
NEO4J_URI=bolt://neo4j:7687

# --- API security ---
# Required in the X-API-Key header for /api/agent/* endpoints
API_KEY=change-me-too

# --- LLM (any OpenAI-compatible endpoint) ---
# LLM_PROVIDER: openai | ollama | mock
#   openai -> OpenAI, Groq, Mistral, OpenRouter... (set LLM_BASE_URL + LLM_API_KEY)
#   ollama -> local model, `docker compose --profile ollama up` then `ollama pull <model>`
#   mock   -> deterministic offline fake LLM (tests / demo without network)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# For Ollama:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:7b

# --- Agent guardrails ---
AGENT_MAX_ATTEMPTS=3
AGENT_MAX_ROWS=50
AGENT_QUERY_TIMEOUT_S=5

# --- Docker image (for `make docker-push`) ---
IMAGE_NAME=yourdockerhubuser/flight-graph-api
